@page
@model BitVid11.Pages.Orders.MyOrdersModel
@{
    ViewData["Title"] = "My Orders";
}

<h2 class="mb-4 text-light">My Orders</h2>

@if (Model.UserOrders == null || !Model.UserOrders.Any())
{
    <div class="alert alert-info" role="alert">
        You have no orders yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle table-dark">
            <thead class="table-dark">
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Tracking Number</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.UserOrders)
                {
                    <tr>
                        <td class="text-light">@order.Id</td>
                        <td class="text-light">@order.CreatedAt.ToString("yyyy-MM-dd")</td>
                        <td>
                            @{
                                var badgeClass = order.OrderStatus switch
                                {
                                    "Completed" => "badge bg-success",
                                    "Pending" => "badge bg-warning text-dark",
                                    "Cancelled" => "badge bg-danger",
                                    _ => "badge bg-secondary"
                                };
                            }
                            <span class="@badgeClass">@order.OrderStatus</span>
                        </td>
                        <td class="text-white">@order.TrackingNumber</td>
                        <td class="text-end">
                            <a asp-page="/Orders/OrderDetails" asp-route-id="@order.Id" class="btn btn-primary btn-sm">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
