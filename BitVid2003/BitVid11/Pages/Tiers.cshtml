@page "/tiers"
@model TiersModel
@{
    ViewData["Title"] = "BitVid — Pricing & Tiers";
    Layout = "_Layout";
}

<div class="container py-5">
    <header class="d-flex flex-column flex-md-row justify-content-between align-items-center text-center text-md-start mb-5">
        <h1 class="fs-2 fw-bold text-white w-100 mb-2 mb-md-0">Select A Plan</h1>
        <span class="badge bg-transparent text-white border border-secondary px-3 py-2 mt-2 mt-md-0">
            Simple billing · Cancel anytime
        </span>
    </header>

    <p class="text-white mb-5 text-center text-md-start fs-5">
        Unlock Tiers
    </p>

    <div class="row g-4">
        @foreach (var t in Model.Tiers)
        {
            var isCurrent = string.Equals(t.Name.Trim(), Model.CurrentSubscription?.Trim(), System.StringComparison.OrdinalIgnoreCase);

            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-lg @(t.IsPopular ? "border border-info border-2" : "")" style="background-color:#1e1e2f; color:#f1f1f1; border-radius:1rem; transition: transform 0.2s;">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h2 class="h5 fw-bold mb-0">@t.Name</h2>

                            @if (t.IsPopular)
                            {
                                <span class="badge bg-info text-dark">Most popular</span>
                            }

                            @if (isCurrent)
                            {
                                <span class="badge bg-success text-white">Your Subscription</span>
                            }
                        </div>

                        <div class="display-5 fw-bold mb-1">
                            @(t.Price == 0 ? "$0" : $"${t.Price}")
                        </div>
                        <small class="text-secondary mb-3">per month</small>

                        <p class="text-secondary">@t.ShortDescription</p>

                        <ul class="list-unstyled border-top pt-3 mb-4" style="border-color:#333;">
                            @foreach (var f in t.Features)
                            {
                                <li class="py-2 border-bottom" style="border-color:#333;">@f</li>
                            }
                        </ul>

                        @if (t.Price == 0)
                        {
                            <a class="btn btn-outline-light w-100 mt-auto @(isCurrent ? "disabled" : "")" href="/signup">
                                @(isCurrent ? "Current Plan" : "Get Started")
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-info w-100 mb-2 fw-bold text-dark mt-auto @(isCurrent ? "disabled" : "")"
                               href="@(isCurrent ? "#" : $"/TierCheckout?Tier={t.Slug}")">
                                @(isCurrent ? "Current Plan" : $"Subscribe — ${t.Price}/mo")
                            </a>
                            <a class="btn btn-outline-light w-100" href="/pricing-details/@t.Slug">Details</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.75rem 1.5rem rgba(0,0,0,0.5);
    }

    .btn-info {
        background-color: #0dcaf0;
        border-color: #0dcaf0;
    }

        .btn-info:hover {
            background-color: #0bb8d9;
            border-color: #0bb8d9;
            color: #000;
        }

    .badge.bg-info {
        background-color: #0dcaf0 !important;
    }

    .text-secondary {
        color: #a0a0b0 !important;
    }
</style>
