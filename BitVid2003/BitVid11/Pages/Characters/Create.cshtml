@page
@model CharactersCreateModel
@{
    ViewData["Title"] = "Create Character";
}

<div class="container mt-5">
    <div class="card dark-card shadow-lg rounded-4">
        <div class="card-header dark-header">
            <h2 class="mb-0">Create Character</h2>
        </div>
        <div class="card-body">
            <form method="post" enctype="multipart/form-data" class="needs-validation" novalidate>

                <!-- Name -->
                <div class="mb-3">
                    <label for="Name" class="form-label fw-bold">Name</label>
                    <input type="text" id="Name" name="Name" class="form-control dark-input" placeholder="Enter character name" required />
                    <div class="invalid-feedback">Please provide a name.</div>
                </div>

                <!-- Context (optional) -->
                <div class="mb-3">
                    <label for="Context" class="form-label fw-bold">Context (optional)</label>
                    <input type="text" id="Context" name="Context" class="form-control dark-input" placeholder="Where Character is From (Optional)" />
                </div>

                <!-- Photo -->
                <div class="mb-3">
                    <label for="Photo" class="form-label fw-bold">Photo</label>
                    <input type="file" id="Photo" name="Photo" class="form-control dark-input" accept="image/*" required />
                    <div class="invalid-feedback">Please upload a photo.</div>
                </div>

                <!-- Reference Audio (disabled) -->
              
                <div class="mb-3">
                    <label for="Voice" class="form-label fw-bold">Reference Audio (optional)</label>
                    <input type="file" id="Voice" name="Voice" class="form-control dark-input" accept="audio/*" />
                    <div class="form-text text-muted">Upload a voice file (mp3, wav, etc.). The file will be saved as your character's name.</div>
                </div>
              

                <!-- Submit -->
                <div class="d-grid mt-3">
                    <button type="submit" class="btn btn-success btn-lg rounded-pill">Submit</button>
                </div>
            </form>

            <!-- Messages -->
            @if (Model.SuccessMessage != null)
            {
                <div class="alert alert-success mt-3" role="alert">
                    @Model.SuccessMessage
                </div>
            }
            @if (Model.ErrorMessage != null)
            {
                <div class="alert alert-danger mt-3" role="alert">
                    @Model.ErrorMessage
                </div>
            }
        </div>
    </div>
</div>

<style>
    body {
        background-color: #121212;
        color: #e0e0e0;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .dark-card {
        background-color: #1e1e1e;
        border: 1px solid #2c2c2c;
    }

    .dark-header {
        background-color: #2a2a2a;
        color: #fff;
        border-bottom: 1px solid #3a3a3a;
    }

    .dark-input {
        background-color: #2a2a2a;
        color: #fff;
        border: 1px solid #444;
        border-radius: 0.5rem;
    }

        .dark-input:focus {
            border-color: #25d366;
            box-shadow: 0 0 0 0.2rem rgba(37, 211, 102, 0.25);
        }

    .btn-success {
        background-color: #25d366;
        border-color: #25d366;
    }

        .btn-success:hover {
            background-color: #20b85d;
            border-color: #20b85d;
        }

    .alert-success {
        background-color: #1e2f1e;
        color: #b5f4b5;
        border-color: #25d366;
    }

    .alert-danger {
        background-color: #2a1e1e;
        color: #f4b5b5;
        border-color: #ff4d6d;
    }

    label {
        color: #f0f0f0;
    }
</style>

@section Scripts {
    <script>
        (() => {
            'use strict';
            const forms = document.querySelectorAll('.needs-validation');
            Array.from(forms).forEach(form => {
                form.addEventListener('submit', event => {
                    if (!form.checkValidity()) {
                        event.preventDefault();
                        event.stopPropagation();
                    }
                    form.classList.add('was-validated');
                }, false);
            });
        })();
    </script>
}
