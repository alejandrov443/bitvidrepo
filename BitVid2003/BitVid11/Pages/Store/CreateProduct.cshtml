@page
@model BitVid11.Pages.Store.CreateProductModel
@{
    ViewData["Title"] = "Create Product";
    Layout = "_Layout2";
}

<div class="create-product-container">
    <h2>➕ Add New Product</h2>

    <form method="post" enctype="multipart/form-data">
        <div asp-validation-summary="All" class="text-red-500 mb-2"></div>

        <label>Character</label>
        <select asp-for="CharacterId">
            <option value="">-- Select Character --</option>
            @foreach (var c in Model.Characters)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </select>
        <span asp-validation-for="CharacterId" class="text-red-500"></span>

        <label>Product Name</label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="text-red-500"></span>

        <label>Price ($)</label>
        <input asp-for="Price" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-red-500"></span>

        <label>Upload Image</label>
        <input asp-for="UploadImage" type="file" accept="image/*" />
        <span asp-validation-for="UploadImage" class="text-red-500"></span>

        <label>Description</label>
        <textarea asp-for="Description" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-red-500"></span>

        <button type="submit">Create Product</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .create-product-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem;
        color: #fff;
    }

    form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        max-width: 400px;
    }

    input, select, textarea {
        padding: 0.6rem;
        border-radius: 0.5rem;
        border: 1px solid #444;
        background-color: #1f1f1f;
        color: #fff;
    }

        input:focus, select:focus, textarea:focus {
            border-color: #ffb400;
            outline: none;
        }

    button {
        background-color: #ffb400;
        border: none;
        padding: 0.8rem;
        border-radius: 0.6rem;
        font-weight: 600;
        cursor: pointer;
        color: #121212;
    }

        button:hover {
            background-color: #ffc933;
        }

    .text-red-500 {
        color: #ff4d4d;
    }
</style>
